function IsCircleofPowerInterruptInteresting()
    local rollSuccess = false
    if context.InterruptedRoll.RollCritical == RollCritical.None then
        rollSuccess = context.InterruptedRoll.Total >= context.InterruptedRoll.Difficulty
    else
        rollSuccess = context.InterruptedRoll.RollCritical == RollCritical.Success
    end
    
	return ConditionResult(rollSuccess)
end

function RitualSpellsInCombat(entity)
    entity = entity or context.Source
    result = ~(Combat(entity) & HasStatus('S5E_RITUAL_CASTING',entity))
    return ConditionResult(result.Result,{ConditionError("RitualSpellsNotInCombat")})
end

function RitualSpells()
    return (SpellId('Shout_DetectMagic') & (ClassLevelHigherOrEqualThan(2,'Artificer') | ClassLevelHigherOrEqualThan(1,'Bard') | ClassLevelHigherOrEqualThan(1,'Cleric') | ClassLevelHigherOrEqualThan(1,'Druid')))
	|  (SpellId('Target_UnseenServant') & ClassLevelHigherOrEqualThan(1,'Bard'))
	|  ((SpellId('Target_Ceremony') | SpellId('Target_Ceremony_BlessWater') | SpellId('Target_Ceremony_ComingOfAge') | SpellId('Target_Ceremony_Dedication')) & ClassLevelHigherOrEqualThan(1,'Cleric'))
	|  (SpellId('Shout_WaterWalk') & (ClassLevelHigherOrEqualThan(9,'Artificer') | ClassLevelHigherOrEqualThan(5,'Cleric') | ClassLevelHigherOrEqualThan(5,'Druid')))
	|  (SpellId('Shout_CommuneWithNature') & ClassLevelHigherOrEqualThan(9,'Druid'))
	|  (SpellId('Shout_SpeakWithAnimals') & (ClassLevelHigherOrEqualThan(1,'Druid') | ClassLevelHigherOrEqualThan(1,'Bard')))
	|  (SpellId('Target_Silence') & ClassLevelHigherOrEqualThan(3,'Cleric'))
	|  (SpellId('Target_FeignDeath') & (ClassLevelHigherOrEqualThan(5,'Druid') | ClassLevelHigherOrEqualThan(5,'Bard') | ClassLevelHigherOrEqualThan(5,'Cleric')))
	|  SpellId('Target_GentleRepose') & ClassLevelHigherOrEqualThan(3,'Cleric')
end

function WarlockLearnRitualSpells()
    return HasPassive('PactOfTheTome',context.Source) and HasPassive('BookOfAncientSecrets',context.Source)
end

function NotGentleReposed(entity)
    entity = entity or context.Target
    result = ~HasStatus('GENTLE_REPOSE',entity)
    return ConditionResult(result.Result,{ConditionError("GentleReposed")})
end

function HasMagicWeaponInInventory(target)
    local entity = entity or context.Target
    local items = GetItemsInInventory(target)
    if items ~= nil then
        for _, entity in ipairs(items.Items) do
            if HasWeaponProperty(WeaponProperties.Magical, entity).Result then
                return ConditionResult(true)
            end
        end
    end

    return ConditionResult(false)
end

function HasMagicItemInInventory(target)
    target = target or context.Target
    local items = GetItemsInInventory(target)
    if items ~= nil then
        for _, item in ipairs(items.Items) do
            if  Tagged('ORI_GALE_CONSUMABLEARTEFACT', item).Result
            or  Tagged('POTION', item).Result
            or  Tagged('HEALING_POTION', item).Result
            or  Tagged('ALCH_SOLUTION_POTION', item).Result
            or  Tagged('SCROLL', item).Result
            or  Tagged('ACT3_LOW_TRESSYMTRADE_MAGICITEM', item).Result
            then
                return ConditionResult(true)
            end
        end
    end
    return ConditionResult(false)
end

function HasMagicalItemInInventoryInContainer(target)
    local entity = entity or context.Target
    local items = GetItemsInInventory(target)
    if items ~= nil then
        for _, entity in ipairs(items.Items) do
            if HasStatus('DETECTED_MAGIC_ITEM_INVENTORY', entity).Result then
                return ConditionResult(true)
            end
        end
    end

    return ConditionResult(false)
end

function IsMagicItem()
    return Tagged('ORI_GALE_CONSUMABLEARTEFACT') | Tagged('POTION') | Tagged('HEALING_POTION') | Tagged('ALCH_SOLUTION_POTION') | Tagged('SCROLL') | Tagged('ACT3_LOW_TRESSYMTRADE_MAGICITEM')
end

function IsIntelligenceCaster(entity)
    local entity = entity or context.Source
    local ability = context.PreferredCastingAbility
    return ConditionResult(
        ability == Ability.Intelligence 
    )
end

function IsWisdomCaster(entity)
    local entity = entity or context.Source
    local ability = context.PreferredCastingAbility
    return ConditionResult(
        ability == Ability.Wisdom 
    )
end

function IsCharismaCaster(entity)
    local entity = entity or context.Source
    local ability = context.PreferredCastingAbility
    return ConditionResult(
        ability == Ability.Charisma 
    )
end

function HasDragonsBreathStatus()
	return HasStatus('DRAGONS_BREATH_FIRE') | HasStatus('DRAGONS_BREATH_COLD') | HasStatus('DRAGONS_BREATH_LIGHTNING') | HasStatus('DRAGONS_BREATH_POISON') | HasStatus('DRAGONS_BREATH_ACID') | HasStatus('DRAGONS_BREATH_FIRE_3') | HasStatus('DRAGONS_BREATH_COLD_3') | HasStatus('DRAGONS_BREATH_LIGHTNING_3') | HasStatus('DRAGONS_BREATH_POISON_3') | HasStatus('DRAGONS_BREATH_ACID_3') | HasStatus('DRAGONS_BREATH_FIRE_4') | HasStatus('DRAGONS_BREATH_COLD_4') | HasStatus('DRAGONS_BREATH_LIGHTNING_4') | HasStatus('DRAGONS_BREATH_POISON_4') | HasStatus('DRAGONS_BREATH_ACID_4') | HasStatus('DRAGONS_BREATH_FIRE_5') | HasStatus('DRAGONS_BREATH_COLD_5') | HasStatus('DRAGONS_BREATH_LIGHTNING_5') | HasStatus('DRAGONS_BREATH_POISON_5') | HasStatus('DRAGONS_BREATH_ACID_5') | HasStatus('DRAGONS_BREATH_FIRE_6') | HasStatus('DRAGONS_BREATH_COLD_6') | HasStatus('DRAGONS_BREATH_LIGHTNING_6') | HasStatus('DRAGONS_BREATH_POISON_6') | HasStatus('DRAGONS_BREATH_ACID_6') | HasStatus('DRAGONS_BREATH_FIRE_7') | HasStatus('DRAGONS_BREATH_COLD_7') | HasStatus('DRAGONS_BREATH_LIGHTNING_7') | HasStatus('DRAGONS_BREATH_POISON_7') | HasStatus('DRAGONS_BREATH_ACID_7') | HasStatus('DRAGONS_BREATH_FIRE_8') | HasStatus('DRAGONS_BREATH_COLD_8') | HasStatus('DRAGONS_BREATH_LIGHTNING_8') | HasStatus('DRAGONS_BREATH_POISON_8') | HasStatus('DRAGONS_BREATH_ACID_8') | HasStatus('DRAGONS_BREATH_FIRE_9') | HasStatus('DRAGONS_BREATH_COLD_9') | HasStatus('DRAGONS_BREATH_LIGHTNING_9') | HasStatus('DRAGONS_BREATH_POISON_9') | HasStatus('DRAGONS_BREATH_ACID_9')
end

function WitherAndBloomHPSpells()
	return SpellId('Shout_WitherAndBloom_RegainHP_d6') | SpellId('Shout_WitherAndBloom_RegainHP_d8') | SpellId('Shout_WitherAndBloom_RegainHP_d10') | SpellId('Shout_WitherAndBloom_RegainHP_d12') | SpellId('Shout_WitherAndBloom_RegainHP_3_d6') | SpellId('Shout_WitherAndBloom_RegainHP_3_d8') | SpellId('Shout_WitherAndBloom_RegainHP_3_d10') | SpellId('Shout_WitherAndBloom_RegainHP_3_d12') | SpellId('Shout_WitherAndBloom_RegainHP_4_d6') | SpellId('Shout_WitherAndBloom_RegainHP_4_d8') | SpellId('Shout_WitherAndBloom_RegainHP_4_d10') | SpellId('Shout_WitherAndBloom_RegainHP_4_d12') | SpellId('Shout_WitherAndBloom_RegainHP_5_d6') | SpellId('Shout_WitherAndBloom_RegainHP_5_d8') | SpellId('Shout_WitherAndBloom_RegainHP_5_d10') | SpellId('Shout_WitherAndBloom_RegainHP_5_d12') | SpellId('Shout_WitherAndBloom_RegainHP_6_d6') | SpellId('Shout_WitherAndBloom_RegainHP_6_d8') | SpellId('Shout_WitherAndBloom_RegainHP_6_d10') | SpellId('Shout_WitherAndBloom_RegainHP_6_d12') | SpellId('Shout_WitherAndBloom_RegainHP_7_d6') | SpellId('Shout_WitherAndBloom_RegainHP_7_d8') | SpellId('Shout_WitherAndBloom_RegainHP_7_d10') | SpellId('Shout_WitherAndBloom_RegainHP_7_d12') | SpellId('Shout_WitherAndBloom_RegainHP_8_d6') | SpellId('Shout_WitherAndBloom_RegainHP_8_d8') | SpellId('Shout_WitherAndBloom_RegainHP_8_d10') | SpellId('Shout_WitherAndBloom_RegainHP_8_d12') | SpellId('Shout_WitherAndBloom_RegainHP_9_d6') | SpellId('Shout_WitherAndBloom_RegainHP_9_d8') | SpellId('Shout_WitherAndBloom_RegainHP_9_d10') | SpellId('Shout_WitherAndBloom_RegainHP_9_d12')
end

function S5E_StatusDoesNotInterruptPerform()
    return StatusId('MAGIC_STONE_MODIFIER_REMOVAL') | StatusId('DRAGONS_BREATH_MODIFIER_REMOVAL')
end

function MagicStoneThrowAttack()
    return Attack(AttackType.RangedSpellAttack)
end

function GetCasterDC(fallbackDC)
    if context.Source == nil then
        return fallbackDC
    end

    ability = context.Source.SpellCastingAbility

    if ability == Ability.Intelligence then
        return 8 + context.Source.IntelligenceModifier + context.Source.ProficiencyBonus
    end

    if ability == Ability.Wisdom then
        return 8 + context.Source.WisdomModifier + context.Source.ProficiencyBonus
    end

    if ability == Ability.Charisma then
        return 8 + context.Source.CharismaModifier + context.Source.ProficiencyBonus
    end

    return fallbackDC
end

function DisadvantageOnParalyzed(target)
    target = target or context.Target

    return Tagged('PARALYZED_DISADV', target)
end

function AdvantageOnStunned(target)
    target = target or context.Target

    return Tagged('STUNNED_ADV', target)
end

function DisadvantageOnStunned(target)
    target = target or context.Target

    return Tagged('STUNNED_DISADV', target)
end

function AdvantageOnFrightenedOrStunned(target)
    target = target or context.Target

    return Tagged('STUNNED_ADV', target) | Tagged('FRIGHTENED_ADV', target)
end

function DisadvantageOnFrightenedOrStunned(target)
    target = target or context.Target

    return Tagged('STUNNED_DISADV', target) | Tagged('FRIGHTENED_DISADV', target)
end